cff-version: 1.2.0
message: "If you use DiffractoKit in your work, please cite it as below, and cite the packages it is checked against (see references)."
title: "DiffractoKit"
type: software
abstract: "A Swift library for crystallography and electron diffraction: unit cells, symmetry, CIF import, d-spacings and reflection lists, electron scattering factors and structure factors, ring and ellipse calibration of diffraction patterns, zone axes, phase mapping and orientation symmetry."
authors:
  - family-names: Lobpreis
    given-names: Paul
version: 0.11.0 # x-release-please-version
date-released: 2026-10-22 # x-release-please-date
license: GPL-3.0-only
repository-code: "https://github.com/mac4DSTEM/DiffractoKit"
keywords:
  - crystallography
  - electron diffraction
  - Swift
